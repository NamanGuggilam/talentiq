# All optional for local development: with nothing set the app runs on embedded Postgres and rule-based drafts.

# Hosted Postgres connection string (Neon, Supabase, RDS...). Unset = embedded PGlite in ./.data
DATABASE_URL=

# Claude drafts summaries and reads resumes when this is set. Unset, or AI_PROVIDER=mock, uses the rule-based engine.
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_MODEL=claude-opus-5
# Hard ceiling on model calls per day across the whole deployment.
AI_DAILY_CAP=600

# Public origin, used for badge QR codes. Unset = taken from the request.
APP_URL=

# Optional: raises GitHub's rate limit when reading linked profiles.
GITHUB_TOKEN=
